# ==============================================================================
# NY2Bolivia Web (Andean Skyline Logistics) - Environment Configuration
# ==============================================================================
# Este archivo sirve como plantilla para las variables de entorno de la aplicación.
#
# MODO OFFLINE POR DEFECTO (Zero-Credentials):
# Para desarrollo y pruebas locales NO se requieren credenciales reales de Firebase.
# La aplicación detecta automáticamente si las variables están ausentes o contienen
# valores placeholder y activa el adaptador de LocalStorage y memoria con datos
# iniciales de prueba (seed orders) sin generar errores.
#
# PASOS PARA CONECTAR GOOGLE FIREBASE EN PRODUCCIÓN:
# 1. Copie este archivo a `.env.local`:
#    cp .env.example .env.local  (o en PowerShell: Copy-Item .env.example .env.local)
# 2. Reemplace los valores placeholder con los datos de su proyecto de Firebase Console.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Firebase Web SDK Client Configuration
# ------------------------------------------------------------------------------
# Obtenga estas credenciales desde:
# Firebase Console (https://console.firebase.google.com/)
#   -> Configuración del Proyecto (Project Settings)
#   -> General
#   -> Tus apps (Your apps) -> App Web (</>)

# Clave de API web pública de Firebase (identifica el proyecto ante las APIs de Google)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForNY2BoliviaWeb2026

# Dominio de autenticación para Firebase Auth (ej: tu-proyecto.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ny2bolivia-logistics.firebaseapp.com

# Identificador único del proyecto en Google Cloud / Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ny2bolivia-logistics

# Bucket de almacenamiento de Firebase Cloud Storage para facturas y recibos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ny2bolivia-logistics.appspot.com

# Número identificador del remitente para Firebase Cloud Messaging (FCM)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475610

# ID único de la aplicación web registrada en el proyecto Firebase
NEXT_PUBLIC_FIREBASE_APP_ID=1:102938475610:web:9a8b7c6d5e4f3a2b1c0d

# ID de medición de Google Analytics 4 asociado a Firebase (opcional)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-NY2BOLIVIA1

# ------------------------------------------------------------------------------
# 2. Parámetros de la Aplicación y Parámetros Logísticos
# ------------------------------------------------------------------------------
# URL base pública de la aplicación desplegada (utilizada para metadata y OpenGraph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Número de WhatsApp oficial para coordinación logística en Bolivia (+591 sin símbolos)
NEXT_PUBLIC_WHATSAPP_SUPPORT_PHONE=59177012345

# Tipo de cambio oficial de referencia en Bolivia (Bolivianos por cada USD)
NEXT_PUBLIC_EXCHANGE_RATE_BOB=6.96

# Tarifa base de flete aéreo directo JFK -> Bolivia ($ USD por libra)
NEXT_PUBLIC_BASE_AIR_FREIGHT_USD_LB=9.50

# Tarifa base de reserva de cupo de vuelo / gestión de casillero ($ USD)
NEXT_PUBLIC_BASE_BOOKING_FEE_USD=20.00

# Porcentaje estándar de comisión para la modalidad "Compra Asistida" (ej. 8 para 8%)
NEXT_PUBLIC_DEFAULT_COMMISSION_PERCENT=8
